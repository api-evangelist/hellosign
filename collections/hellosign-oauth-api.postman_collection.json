          "id": "411323a2-42f9-4c5f-aa82-39d8ff576c60",
          "name": "OAuth Token Refresh",
          "request": {
            "name": "OAuth Token Refresh",
            "description": {
              "content": "Access tokens are only valid for a given period of time (typically one hour) for security reasons. Whenever acquiring an new access token its TTL is also given (see `expires_in`), along with a refresh token that can be used to acquire a new access token after the current one has expired.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "oauth",
                "token"
              ],
              "host": [
                "app",
                "hellosign",
                "com"
              ],
              "query": [
                {
                  "key": "refresh",
                  "value": "null"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"refresh_token\",\n  \"refresh_token\": \"<string>\",\n  \"client_id\": \"<string>\",\n  \"client_secret\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
